RESOURCE_DB_URL=jdbc:postgresql://${RESOURCE_DB_HOST}:${RESOURCE_DB_PORT}/${RESOURCE_DB_NAME}
SONG_DB_URL=jdbc:postgresql://${SONG_DB_HOST}:${SONG_DB_PORT}/${SONG_DB_NAME}
